{
  "info": {
    "_postman_id": "guardian-backend-api-collection",
    "name": "GUARDIAN Backend API",
    "description": "Full Postman collection for GUARDIAN Spring Boot backend testing, covering Auth, Scans, IDOR protection, validation, and error states.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentScanId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health & Docs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service is UP', function () { var json = pm.response.json(); pm.expect(json.status).to.eql('UP'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger-ui.html",
              "host": ["{{baseUrl}}"],
              "path": ["swagger-ui.html"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 302', function () { pm.expect(pm.response.code).to.be.oneOf([200, 302]); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_dev\",\n  \"email\": \"postman_dev@guardian.io\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login with Username",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_dev\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('JWT token present', function () { pm.expect(data.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('authToken', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login with Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_dev@guardian.io\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Username is canonical', function () { pm.expect(data.username).to.eql('postman_dev'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login as Admin (Dev Seeded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Role is ROLE_ADMIN', function () { pm.expect(data.role).to.eql('ROLE_ADMIN'); });",
                  "pm.collectionVariables.set('adminToken', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login with Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"WrongPass999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "var json = pm.response.json();",
                  "pm.test('Error body contains traceId', function () { pm.expect(json.traceId).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Scans & Bug Prediction",
      "item": [
        {
          "name": "Analyze Single Snippet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeSnippet\": \"public void test(String s) { if (s == null) { s.trim(); } }\",\n  \"repo\": \"SampleRepo\",\n  \"filepath\": \"Sample.java\",\n  \"functionName\": \"test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans", "analyze"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Contains isBuggy property', function () { pm.expect(data).to.have.property('isBuggy'); });",
                  "pm.test('Does not contain buggy property', function () { pm.expect(data).to.not.have.property('buggy'); });",
                  "if (data.repositoryScanId) { pm.collectionVariables.set('currentScanId', data.repositoryScanId); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Batch Scan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repoName\": \"PostmanTestRepo\",\n  \"repoUrl\": \"https://github.com/test/repo\",\n  \"branch\": \"main\",\n  \"commitHash\": \"abcdef123\",\n  \"snippets\": [\n    {\n      \"filePath\": \"Service.java\",\n      \"functionName\": \"execute\",\n      \"codeSnippet\": \"public int execute(int x) { return x * 2; }\"\n    },\n    {\n      \"filePath\": \"Utils.java\",\n      \"functionName\": \"parse\",\n      \"codeSnippet\": \"public String parse(Object o) { return o.toString(); }\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test('totalFilesScanned is 2', function () { pm.expect(data.totalFilesScanned).to.eql(2); });",
                  "pm.collectionVariables.set('currentScanId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User Scans (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Total-Count header exists', function () { pm.response.to.have.header('X-Total-Count'); });",
                  "pm.test('Body is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Scan by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans/{{currentScanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans", "{{currentScanId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Scan ID matches', function () { pm.expect(data.id.toString()).to.eql(pm.collectionVariables.get('currentScanId')); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Scan Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans/{{currentScanId}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans", "{{currentScanId}}", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Health status present', function () { pm.expect(data).to.have.property('overallHealthStatus'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Contains totalScans', function () { pm.expect(data).to.have.property('totalScans'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin All Scans (all=true)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"],
              "query": [
                {
                  "key": "all",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Security & Error Handling",
      "item": [
        {
          "name": "Missing Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "var json = pm.response.json();",
                  "pm.test('Error is Unauthorized', function () { pm.expect(json.error).to.eql('Unauthorized'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid JWT Token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.garbage.token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Non-Admin all=true (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans"],
              "query": [
                {
                  "key": "all",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', function () { pm.response.to.have.status(403); });",
                  "var json = pm.response.json();",
                  "pm.test('Error is Forbidden', function () { pm.expect(json.error).to.eql('Forbidden'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid Path Variable (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scans/invalid_numeric_id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scans", "invalid_numeric_id"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unknown Route (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/not-found-route",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "not-found-route"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
